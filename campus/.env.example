# ============================================================
# 清华校园技能包 统一配置（campus/.env）
# 所有"大配置"统一放这里：学号/姓名/CAS 密码/邮箱/API key。
# 复制本文件为 .env 后填入你自己的值。本文件已被 .gitignore 忽略，不会上传。
# ============================================================

# ---------- 身份信息 ----------
STUDENT_ID=你的学号
STUDENT_NAME=你的姓名
CAS_USERNAME=你的学号（CAS 登录账号）
CAS_PASSWORD=你的统一认证密码

# ---------- 邮箱配置（JSON 数组，支持多账户） ----------
# 授权码获取：各邮箱设置→开启 IMAP/SMTP→生成授权码（不是登录密码）
# 清华: mails.tsinghua.edu.cn / QQ: smtp.qq.com / 腾讯企业: smtp.exmail.qq.com
MAIL_ACCOUNTS=[
  {
    "name": "tsinghua",
    "label": "清华邮箱",
    "imap_host": "mails.tsinghua.edu.cn",
    "imap_port": 993,
    "smtp_host": "mails.tsinghua.edu.cn",
    "smtp_port": 465,
    "smtp_ssl": true,
    "user": "你的学号@mails.tsinghua.edu.cn",
    "password": "你的授权码",
    "from_name": "你的姓名"
  }
]

# ---------- 可选 API（不配则相关功能不可用） ----------
SCOPUS_API_KEY=
DEEPSEEK_API_KEY=
