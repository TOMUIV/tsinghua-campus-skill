# ============================================================
# 清华校园技能包 统一配置（campus/.env）
# 所有"大配置"统一放这里：学号/姓名/邮箱/API key。
# 复制本文件为 .env 后填入你自己的值。本文件已被 .gitignore 忽略，不会上传。
#
# 注意：CAS 账号/密码等安全凭据不放这里，走加密保险箱：
#   python creds/scripts/creds.py add <key> --value-stdin
#   （值存 campus/runtime/credentials.enc，整体 Fernet 加密）
#
# 跨机同步：主密钥不在 .env，而是操作系统环境变量 CAMPUS_MASTER_KEY
#   （各设备填同一个值即可解密同步过来的保险箱；见 creds.py key show）
# ============================================================

# ---------- 身份信息 ----------
STUDENT_ID=你的学号
STUDENT_NAME=你的姓名

# ---------- 邮箱配置（JSON 数组，支持多账户） ----------
# 授权码获取：各邮箱设置→开启 IMAP/SMTP→生成授权码（不是登录密码）
# 清华: mails.tsinghua.edu.cn / QQ: smtp.qq.com / 腾讯企业: smtp.exmail.qq.com
MAIL_ACCOUNTS=[
  {
    "name": "tsinghua",
    "label": "清华邮箱",
    "imap_host": "mails.tsinghua.edu.cn",
    "imap_port": 993,
    "smtp_host": "mails.tsinghua.edu.cn",
    "smtp_port": 465,
    "smtp_ssl": true,
    "user": "你的学号@mails.tsinghua.edu.cn",
    "password": "你的授权码",
    "from_name": "你的姓名"
  }
]

# ---------- 可选 API（不配则相关功能不可用） ----------
SCOPUS_API_KEY=
DEEPSEEK_API_KEY=

# ---------- 高德地图 Web 服务 API ----------
# 用于查地点、POI 搜索、周边搜索（清华校内餐馆/便利店）、路径规划、地理编码、天气等。
# 获取：https://console.amap.com → 注册开发者 → 应用管理 → 创建新应用 → 添加 Key
#  → 服务平台必须选【Web 服务】（不是 Web 端/JS API，那两个是浏览器用的）
#  → 名称随便填（如"校园技能包"）；白名单 IP 不填则所有 IP 都能用（个人开发够用）
#  → 创建后复制 Key 填到下面。免费版每日 5000 次个人调用额度，超额停服（非扣费）。
# 申请页：https://lbs.amap.com/api/key
# 控制台：https://console.amap.com/dev/key/app
AMAP_KEY=

# ---------- OpenAlex（免费学术元数据，无需 Key） ----------
# 用于 literature 元数据检索（替代部分付费 Scopus 场景）。
# 强烈建议注册获取免费 API Key：https://openalex.org/settings/api
# 不配也能用，但每天仅 $0.01 额度且易 429；配 Key 升级到 $1/天。
OPENALEX_API_KEY=

# ---------- Crossref（免费，无需 Key） ----------
# 文献元数据补充源（与 OpenAlex 互为冗余，提高命中率）。无需配置。

